# Skopiuj do .env i uzupełnij. .env NIE jest commitowany (patrz .gitignore).

# --- Środowisko ---
# Development używa osobnego bota Telegram i nie uruchamia schedulera.
# Na VPS użyj: ./deploy/install.sh production
APP_ENV=development
SCHEDULER_ENABLED=false

# --- PostgreSQL / Compose ---
# Użyj długiego, losowego hasła bez znaków wymagających kodowania w URL.
# deploy/install.sh generuje je automatycznie przy nowej instalacji.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://health_agent:UZUPELNIJ@localhost:5432/health_agent
API_PORT=8000

# --- LLM ---
ANTHROPIC_API_KEY=
# Domyślny model Claude (patrz scripts/test_llm_pydantic_ai.py)
CLAUDE_MODEL=anthropic:claude-opus-5

# Ollama - lokalny model. qwen3:14b poprawnie obsługuje tool calling,
# qwen2.5-coder:14b w tej wersji Ollamy NIE (patrz notatka w skrypcie).
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Telegram ---
# Token od @BotFather (/newbot). Development i production MUSZĄ używać
# osobnych botów/tokenów, jeśli mogą działać równocześnie.
TELEGRAM_BOT_TOKEN=
# Uzupełnij po pierwszym uruchomieniu bota - zobaczysz go w konsoli
TELEGRAM_CHAT_ID=

# --- Fitatu (scripts/test_fitatu.py) ---
# Wyciągnij z DevTools przeglądarki (Local Storage lub nagłówek Authorization
# w zakładce Network przy zapytaniach do api.fitatu.com) - patrz instrukcja
# w docstringu skryptu.
FITATU_BEARER_TOKEN=
FITATU_REFRESH_TOKEN=
FITATU_USER_ID=

# --- Health Connect Webhook (scripts/test_healthconnect_webhook.py) ---
# Dowolny losowy string - wpisz go też jako nagłówek X-Webhook-Secret
# w konfiguracji webhooka w apce "Health Connect Webhook" na telefonie.
WEBHOOK_SHARED_SECRET=

# --- Dashboard i lokalne archiwum zdjęć ---
# Wygeneruj: uv run health-agent hash-password
DASHBOARD_PASSWORD_HASH=
# disabled | local | tailscale | public
DASHBOARD_ACCESS_MODE=local
# Pełny adres podawany przez bota w trybie tailscale/public.
DASHBOARD_URL=
# Opcjonalne adresy lub CIDR rozdzielone przecinkami, np. 100.64.0.10/32.
DASHBOARD_ALLOWED_IPS=
# Proxy, od których aplikacja może przyjąć X-Forwarded-For.
DASHBOARD_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Dla lokalnego HTTP ustaw false. Na VPS za HTTPS pozostaw true.
# DASHBOARD_COOKIE_SECURE=true
# PROGRESS_PHOTOS_DIR=data/photos
# PROGRESS_PHOTO_MAX_BYTES=15728640
# PROGRESS_PHOTO_MAX_PIXELS=25000000

# --- Intervals.icu ---
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- Alerty (scheduler.py: check_stale_sources) - wszystko opcjonalne, są sensowne domyślne ---
# ALERTS_ENABLED=true
# ALERTS_STALE_HOURS=48
# ALERTS_CHECK_INTERVAL_MINUTES=60

# --- Backup bazy (scheduler.py: backup_database) - wszystko opcjonalne ---
# BACKUP_ENABLED=true
# BACKUP_DIR=backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14

# --- Podsumowania Telegram (domyślnie wyłączone; strefa IANA) ---
# SUMMARY_TIMEZONE=Europe/Warsaw
# DAILY_SUMMARY_ENABLED=false
# DAILY_SUMMARY_HOUR=20
# DAILY_SUMMARY_MINUTE=30
# WEEKLY_SUMMARY_ENABLED=false
# WEEKLY_SUMMARY_DAY=sun
# WEEKLY_SUMMARY_HOUR=20
# WEEKLY_SUMMARY_MINUTE=0

# --- Korelacje i przypomnienia ---
# Korelacje najpierw sprawdź ręcznie: health-agent correlations
# CORRELATIONS_ENABLED=false
# CORRELATIONS_DAY=sun
# CORRELATIONS_HOUR=19
# CORRELATIONS_MINUTE=0
# REMINDERS_ENABLED=true
# REMINDER_DATA_FRESH_HOURS=2
