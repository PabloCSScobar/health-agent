# Skopiuj do .env i uzupełnij. .env NIE jest commitowany (patrz .gitignore).

# --- PostgreSQL / Compose ---
# Użyj długiego, losowego hasła bez znaków wymagających kodowania w URL.
# deploy/install.sh generuje je automatycznie przy nowej instalacji.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://health_agent:UZUPELNIJ@localhost:5432/health_agent
API_PORT=8000

# --- LLM ---
ANTHROPIC_API_KEY=
# Domyślny model Claude (patrz scripts/test_llm_pydantic_ai.py)
CLAUDE_MODEL=anthropic:claude-opus-5

# Ollama - lokalny model. qwen3:14b poprawnie obsługuje tool calling,
# qwen2.5-coder:14b w tej wersji Ollamy NIE (patrz notatka w skrypcie).
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Telegram (scripts/test_telegram_bot.py) ---
# Token od @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Uzupełnij po pierwszym uruchomieniu bota - zobaczysz go w konsoli
TELEGRAM_CHAT_ID=

# --- Fitatu (scripts/test_fitatu.py) ---
# Wyciągnij z DevTools przeglądarki (Local Storage lub nagłówek Authorization
# w zakładce Network przy zapytaniach do api.fitatu.com) - patrz instrukcja
# w docstringu skryptu.
FITATU_BEARER_TOKEN=
FITATU_REFRESH_TOKEN=
FITATU_USER_ID=

# --- Health Connect Webhook (scripts/test_healthconnect_webhook.py) ---
# Dowolny losowy string - wpisz go też jako nagłówek X-Webhook-Secret
# w konfiguracji webhooka w apce "Health Connect Webhook" na telefonie.
WEBHOOK_SHARED_SECRET=

# --- Intervals.icu ---
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- Alerty (scheduler.py: check_stale_sources) - wszystko opcjonalne, są sensowne domyślne ---
# ALERTS_ENABLED=true
# ALERTS_STALE_HOURS=48
# ALERTS_CHECK_INTERVAL_MINUTES=60

# --- Backup bazy (scheduler.py: backup_database) - wszystko opcjonalne ---
# BACKUP_ENABLED=true
# BACKUP_DIR=backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14
